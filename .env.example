# Copy to .env on the server and fill in. Never commit .env.

# Free keys: https://finnhub.io and https://www.alphavantage.co
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# A long random string; generate one with: openssl rand -hex 32
JWT_SECRET=

# Database password; generate one the same way
POSTGRES_PASSWORD=
POSTGRES_USER=etf
POSTGRES_DB=etf

# Identifies the app to the SEC when it downloads their ticker list: "app-name you@example.com"
SEC_USER_AGENT=

# The localhost port the server's nginx proxies to
WEB_PORT=8080
